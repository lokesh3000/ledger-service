{
  "info": {
    "name": "Ledger Service - Phase 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Setup: SYSTEM account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bank Reserve\",\n  \"type\": \"SYSTEM\",\n  \"currency\": \"USD\",\n  \"allowNegative\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('systemId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Setup: Alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice\",\n  \"type\": \"USER\",\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('aliceId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Setup: Bob",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bob\",\n  \"type\": \"USER\",\n  \"currency\": \"USD\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('bobId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Fund Alice 10000",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "fund-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transfers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAccountId\": \"{{systemId}}\",\n  \"toAccountId\": \"{{aliceId}}\",\n  \"amount\": 10000,\n  \"currency\": \"USD\",\n  \"description\": \"Funding\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Place hold 6000 on Alice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "hold-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/holds",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "holds"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{aliceId}}\",\n  \"amount\": 6000,\n  \"currency\": \"USD\",\n  \"description\": \"Card authorisation\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('ACTIVE', () => pm.expect(pm.response.json().status).to.eql('ACTIVE'));",
              "pm.collectionVariables.set('holdId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Alice: balance 10000, held 6000, available 4000",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const a = pm.response.json();",
              "pm.test('balance 10000', () => pm.expect(a.balance).to.eql(10000));",
              "pm.test('held 6000', () => pm.expect(a.held).to.eql(6000));",
              "pm.test('available 4000', () => pm.expect(a.available).to.eql(4000));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Spend 5000 (more than available) -> 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "blocked-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transfers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAccountId\": \"{{aliceId}}\",\n  \"toAccountId\": \"{{bobId}}\",\n  \"amount\": 5000,\n  \"currency\": \"USD\",\n  \"description\": \"blocked by hold\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('held money cannot be spent', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. REPLAY place-hold (same key) -> 200 + header",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "hold-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/holds",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "holds"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{aliceId}}\",\n  \"amount\": 6000,\n  \"currency\": \"USD\",\n  \"description\": \"Card authorisation\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('replay', () => pm.response.to.have.status(200));",
              "pm.test('replay header', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
              "pm.test('same hold id', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('holdId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Capture hold into Bob",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "capture-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/holds/{{holdId}}/capture",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "holds",
            "{{holdId}}",
            "capture"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toAccountId\": \"{{bobId}}\",\n  \"description\": \"Order #1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('CAPTURED', () => pm.expect(pm.response.json().status).to.eql('CAPTURED'));",
              "pm.collectionVariables.set('captureTxId', pm.response.json().captureTransactionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Capture again (new key) -> 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "capture2-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/holds/{{holdId}}/capture",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "holds",
            "{{holdId}}",
            "capture"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toAccountId\": \"{{bobId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('second capture rejected', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Alice 4000 / held 0, Bob 6000",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const a = pm.response.json();",
              "pm.test('balance 4000', () => pm.expect(a.balance).to.eql(4000));",
              "pm.test('held 0', () => pm.expect(a.held).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Reverse the capture transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "reverse-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{captureTxId}}/reverse",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{captureTxId}}",
            "reverse"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.test('points at original', () => pm.expect(pm.response.json().reversalOf).to.eql(pm.collectionVariables.get('captureTxId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Reverse again (new key) -> 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "reverse2-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions/{{captureTxId}}/reverse",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions",
            "{{captureTxId}}",
            "reverse"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('already reversed', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Alice back to 10000, Bob 0",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('balance 10000', () => pm.expect(pm.response.json().balance).to.eql(10000));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Place hold 1000",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "hold2-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/holds",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "holds"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{aliceId}}\",\n  \"amount\": 1000,\n  \"currency\": \"USD\",\n  \"description\": \"to be released\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('holdId2', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Release hold 1000",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "release-{{runId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/holds/{{holdId2}}/release",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "holds",
            "{{holdId2}}",
            "release"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('RELEASED', () => pm.expect(pm.response.json().status).to.eql('RELEASED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Alice held back to 0",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('held 0', () => pm.expect(pm.response.json().held).to.eql(0));",
              "pm.test('available 10000', () => pm.expect(pm.response.json().available).to.eql(10000));"
            ]
          }
        }
      ]
    },
    {
      "name": "18. History page 0, size 2 (newest first)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}/entries?page=0&size=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}",
            "entries"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "2"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const p = pm.response.json();",
              "pm.test('2 items on first page', () => pm.expect(p.items.length).to.eql(2));",
              "pm.test('3 entries total (fund, capture, reversal)', () => pm.expect(p.totalElements).to.eql(3));",
              "pm.test('has next page', () => pm.expect(p.hasNext).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "19. History page 1, size 2",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}/entries?page=1&size=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}",
            "entries"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "size",
              "value": "2"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const p = pm.response.json();",
              "pm.test('1 item on second page', () => pm.expect(p.items.length).to.eql(1));",
              "pm.test('no next page', () => pm.expect(p.hasNext).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "20. History with size=500 -> 400",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{aliceId}}/entries?page=0&size=500",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{aliceId}}",
            "entries"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "500"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('page size is capped', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "21. Reconciliation: books must be consistent",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/reconciliation",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "reconciliation"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('consistent', () => pm.expect(r.consistent).to.eql(true));",
              "pm.test('no problems', () => pm.expect(r.problems.length).to.eql(0));"
            ]
          }
        }
      ]
    }
  ]
}